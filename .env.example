# Coolify runtime environment variables — copy into Coolify env UI per host deployment.
# All variables below are runtime (not build-time).

# =============================================================================
# REQUIRED — SigNoz connection
# =============================================================================

# Your SigNoz server hostname or IP (no protocol prefix)
SIGNOZ_HOST=otel.roborew.xyz

# OTLP gRPC port on the SigNoz server (default for self-hosted)
SIGNOZ_OTLP_PORT=443

# Ingestion key — required for SigNoz Cloud only; leave empty/unset for self-hosted
SIGNOZ_INGESTION_KEY=

# =============================================================================
# OPTIONAL — SigNoz connection overrides
# =============================================================================

# Override the full endpoint (host:port) instead of SIGNOZ_HOST + SIGNOZ_OTLP_PORT
# SIGNOZ_OTLP_ENDPOINT=10.0.1.100:4317

# Set false if SigNoz OTLP uses TLS (e.g. SigNoz Cloud or HTTPS ingress on 443)
SIGNOZ_OTLP_INSECURE=true

# Resource attribute for grouping hosts in SigNoz
DEPLOYMENT_ENVIRONMENT=prod-coolify-host-01

# =============================================================================
# OPTIONAL — Collector tuning
# =============================================================================

OTEL_COLLECTOR_VERSION=0.139.0
HOSTMETRICS_INTERVAL=60s
DOCKER_STATS_INTERVAL=10s
DOCKER_STATS_API_VERSION=1.44
FILELOG_START_AT=end
MEMORY_LIMITER_LIMIT_MIB=4000
MEMORY_LIMITER_SPIKE_MIB=800

# =============================================================================
# Examples
# =============================================================================

# --- Self-hosted SigNoz (no ingestion key) ---
# SIGNOZ_HOST=10.0.1.100
# SIGNOZ_OTLP_PORT=4317
# SIGNOZ_OTLP_INSECURE=true

# --- SigNoz Cloud ---
# SIGNOZ_HOST=ingest.us.signoz.cloud
# SIGNOZ_OTLP_PORT=443
# SIGNOZ_INGESTION_KEY=your-ingestion-key-here
# SIGNOZ_OTLP_INSECURE=false
