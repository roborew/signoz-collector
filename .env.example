# Coolify runtime environment variables — copy into Coolify env UI per host deployment.
# All variables below are runtime (not build-time).
# Full contract (collector vs app OTEL vars): see README.md.

# =============================================================================
# REQUIRED — SigNoz connection (collector only — do NOT set these on app services)
# =============================================================================

# Full OTLP endpoint URL. Through Cloudflare this MUST be the HTTPS base URL
# (port 443 implied); the collector appends /v1/traces, /v1/metrics, /v1/logs.
SIGNOZ_OTLP_ENDPOINT=https://otel.roborew.xyz

# SigNoz hostname (no protocol prefix) — used for resource attributes / fallback.
SIGNOZ_HOST=otel.roborew.xyz

# Ingestion key — required for SigNoz Cloud only; leave empty/unset for self-hosted
SIGNOZ_INGESTION_KEY=

# =============================================================================
# OPTIONAL — SigNoz connection overrides
# =============================================================================

# Direct LAN gRPC alternative (no Cloudflare) — requires switching the exporter
# in config.yaml back to the gRPC 'otlp' exporter with tls.insecure: true:
# SIGNOZ_OTLP_ENDPOINT=192.168.1.4:4317

# Resource attribute for grouping hosts in SigNoz
DEPLOYMENT_ENVIRONMENT=prod-coolify-host-01

# =============================================================================
# OPTIONAL — Collector tuning
# =============================================================================

OTEL_COLLECTOR_VERSION=0.139.0
HOSTMETRICS_INTERVAL=60s
DOCKER_STATS_INTERVAL=10s
DOCKER_STATS_API_VERSION=1.44
FILELOG_START_AT=end
MEMORY_LIMITER_LIMIT_MIB=4000
MEMORY_LIMITER_SPIKE_MIB=800

# =============================================================================
# Application OTEL (set on *app* Coolify services — NOT on this collector)
# =============================================================================
# Apps on the same Docker host reach this host-networked collector via the host
# gateway. Add to each instrumented service:
#   extra_hosts: ["host.docker.internal:host-gateway"]
# and set:
#
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
#   OTEL_SERVICE_NAME=your-unique-service-name
#
# Do NOT set on apps:
#   - SIGNOZ_* (collector-only)
#   - OTEL_EXPORTER_OTLP_HEADERS (not needed for self-hosted via this collector)
#   - OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.roborew.xyz (bypasses the collector)
#   - localhost:4318 (localhost inside a bridge container is not the host)
#
# See README.md "App project checklist".

# =============================================================================
# Examples
# =============================================================================

# --- Self-hosted SigNoz via Cloudflare (OTLP/HTTP, no ingestion key) ---
# SIGNOZ_OTLP_ENDPOINT=https://otel.roborew.xyz
# SIGNOZ_INGESTION_KEY=

# --- SigNoz Cloud (OTLP/HTTP) ---
# SIGNOZ_OTLP_ENDPOINT=https://ingest.us.signoz.cloud
# SIGNOZ_INGESTION_KEY=your-ingestion-key-here
